# 初始管理员账号（首次启动时自动创建，之后在「我的 → 修改密码」中修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 旧版单用户密码（兼容保留：没设 ADMIN_PASSWORD 时会作为管理员初始密码）
APP_PASSWORD=

# 开放注册的邀请码。留空 = 关闭注册，只有管理员能在「用户管理」里添加账号
SIGNUP_CODE=

# 服务端口
PORT=8080
HOST=0.0.0.0

# 数据目录（SQLite 数据库存放位置）
DATA_DIR=./data

# DeepSeek（也可以在 App 的「我的」页面里按账号填，界面填写的优先级更高）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# PDF 导出使用的中文字体（可选，默认 assets/fonts/NotoSansSC-Regular.ttf）
PDF_FONT_PATH=

# 时区，影响「今天」的判断
TZ=Asia/Shanghai

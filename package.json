{
  "name": "fitlog",
  "version": "1.1.1",
  "description": "私人健身训练记录系统（动作库 + 训练记录 + 训练动态留言 + DeepSeek 计划）",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch --env-file=.env server/index.js",
    "build:data": "node scripts/build-data.mjs",
    "fetch:media": "node scripts/fetch-media.mjs",
    "fetch:gifs": "node scripts/fetch-media.mjs --gifs",
    "seed:demo": "node scripts/seed-demo.mjs 7",
    "seed:social": "node scripts/seed-social-demo.mjs",
    "smoke:social": "node --env-file=.env scripts/smoke-social.mjs",
    "e2e:social": "node --env-file=.env scripts/e2e-social.mjs",
    "reset": "node scripts/reset-data.mjs",
    "shots": "node scripts/screenshots.mjs",
    "fetch:font": "node scripts/fetch-font.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "pdfkit": "^0.20.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}

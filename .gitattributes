# 统一换行符，避免 Windows / Linux 互相污染
* text=auto eol=lf

# Windows 批处理必须是 CRLF，cmd 解析 LF 结尾的 .bat 会出问题
*.bat text eol=crlf
*.cmd text eol=crlf

# 签名材料一律按二进制处理
*.keystore binary
*.jks binary

# 二进制资源，不做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.pdf binary
*.db binary
